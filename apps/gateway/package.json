{
  "name": "@okbot/gateway",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "OkBot headless gateway (okbot serve) and shared server modules",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "okbot": "./bin/okbot.mjs"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-node-tests.mjs --root . --import tsx",
    "dev:serve": "node --import tsx src/cli.ts serve"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@okbot/agent": "workspace:*",
    "@okbot/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "electron": ">=37"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  }
}
