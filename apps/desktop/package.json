{
  "name": "@okbot/desktop",
  "version": "0.12.0",
  "private": true,
  "description": "OkBot desktop shell",
  "main": "./out/main/index.js",
  "type": "module",
  "bin": {
    "okbot": "../../gateway/bin/okbot.mjs"
  },
  "scripts": {
    "dev": "pnpm --filter @okbot/shared build && pnpm --filter @okbot/agent build && pnpm --filter @okbot/gateway build && node ./scripts/sync-gallery.mjs && node ./scripts/ensure-mic-plist.mjs && electron-vite dev",
    "ensure-mic": "node ./scripts/ensure-mic-plist.mjs",
    "build": "pnpm --filter @okbot/shared build && pnpm --filter @okbot/agent build && pnpm --filter @okbot/gateway build && node ./scripts/sync-gallery.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "pnpm build && electron-builder --config electron-builder.yml",
    "dist:mac": "pnpm build && electron-builder --config electron-builder.yml --mac",
    "dist:dir": "pnpm build && electron-builder --config electron-builder.yml --mac --dir",
    "publish:github": "pnpm build && electron-builder --config electron-builder.yml --mac --publish always",
    "test:session-jsonl": "pnpm --filter @okbot/gateway exec node --import tsx src/storage/sessionJsonl.test.ts",
    "test:usage-store": "pnpm --filter @okbot/gateway exec node --import tsx src/storage/usageStore.test.ts",
    "test": "node ../../scripts/run-node-tests.mjs --root . --import tsx",
    "test:gateway": "pnpm --filter @okbot/gateway exec node --import tsx src/gatewayHttpApi.gateway.test.ts"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@okbot/agent": "workspace:*",
    "@okbot/gateway": "workspace:*",
    "@okbot/shared": "workspace:*",
    "border-beam": "^1.3.0",
    "bot-avatars": "0.2.2",
    "electron-updater": "^6.6.2",
    "emoji-mart": "^5.6.0",
    "highlight.js": "^11.12.0",
    "liquid-gooey": "^0.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "thinking-orbs": "^0.3.1",
    "voice-glow": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  },
  "author": "shuzheng",
  "repository": {
    "type": "git",
    "url": "https://github.com/shuzheng/okbot.git"
  }
}
